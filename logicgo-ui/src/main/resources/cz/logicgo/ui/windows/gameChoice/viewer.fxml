<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.controlsfx.control.SegmentedButton?>
<BorderPane fx:id="rootPane" prefHeight="650.0" prefWidth="900.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER" spacing="10" styleClass="header-pane" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" top="15.0"/>
            </padding>
            <children>
                <SegmentedButton fx:id="viewToggleGroup">
                    <buttons>
                        <ToggleButton fx:id="layoutsButton" selected="true" text="Layouts"/>
                        <ToggleButton fx:id="favouritesButton" text="Favourites"/>
                        <ToggleButton fx:id="customsButton" text="Vlastní výtvory"/>
                    </buttons>
                </SegmentedButton>
            </children>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="canvasPane" styleClass="canvas-pane" BorderPane.alignment="CENTER">
            <children>
                <Canvas fx:id="canvas"/>
            </children>
        </StackPane>
    </center>

    <right>

        <VBox alignment="TOP_CENTER" fillWidth="false" prefWidth="250.0" spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <children>
                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label fx:id="statusLabel" styleClass="title-label" text="No layouts"/>
                        <Label fx:id="infoLabel" styleClass="text-muted"/>
                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="10.0">
                    <Button fx:id="prevButton" mnemonicParsing="false" styleClass="btn-secondary" text="&lt;&lt;"/>
                    <Button fx:id="nextButton" mnemonicParsing="false" styleClass="btn-secondary" text="&gt;&gt;"/>
                </HBox>

                <Button fx:id="favouriteButton" mnemonicParsing="false" prefWidth="150.0" styleClass="btn-secondary"
                        text="Favourite"/>

                <Button fx:id="deleteButton" mnemonicParsing="false" prefWidth="150.0"
                        style="-fx-text-fill: #ff6b6b; -fx-border-color: #ff6b6b;" styleClass="btn-secondary"
                        text="Smazat"/>

                <Button fx:id="openEditorButton" mnemonicParsing="false" prefWidth="150.0" styleClass="btn-secondary"
                        text="Vytvořit nový"/>

                <Pane VBox.vgrow="ALWAYS"/>
                <Button fx:id="okButton" mnemonicParsing="false" prefHeight="40.0" prefWidth="150.0"
                        styleClass="btn-primary" text="Vybrat"/>
            </children>
        </VBox>
    </right>

</BorderPane>
