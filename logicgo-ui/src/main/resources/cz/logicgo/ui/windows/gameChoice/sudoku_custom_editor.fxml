<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:id="rootPane" prefHeight="650.0" prefWidth="900.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER" styleClass="header-pane" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" top="15.0"/>
            </padding>
            <Label fx:id="mainTitleLabel" text="Vytvořit" styleClass="title-label"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="gameContainer" styleClass="game-container-wrapper" BorderPane.alignment="CENTER">
            <Pane fx:id="canvasPane" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="500.0" prefWidth="500.0"
                  styleClass="canvas-pane">
                <Canvas fx:id="canvas" height="500.0" width="500.0"/>
            </Pane>
        </StackPane>
    </center>

    <right>
        <VBox alignment="TOP_CENTER" fillWidth="true" prefWidth="250.0" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <children>
                <Label styleClass="text-muted" wrapText="true"/>

                <TilePane fx:id="palettePane" alignment="CENTER" hgap="10" vgap="10" prefColumns="3"
                          prefTileWidth="40.0" prefTileHeight="40.0" maxWidth="-Infinity"/>


                <VBox alignment="CENTER" spacing="12.0" styleClass="dashboard-widget" prefWidth="210.0"
                      maxWidth="Infinity">
                    <Label text="Test" styleClass="widget-title" alignment="CENTER" textAlignment="CENTER"
                           maxWidth="Infinity"/>

                    <StackPane alignment="CENTER" maxWidth="Infinity">
                        <HBox alignment="CENTER" spacing="10.0" maxWidth="Infinity">
                            <Button fx:id="testButton" mnemonicParsing="false" styleClass="btn-secondary"
                                    text="Spustit test" alignment="CENTER"/>
                            <ProgressIndicator fx:id="testProgress" visible="false" managed="false" prefWidth="20"
                                               prefHeight="20"/>
                        </HBox>
                    </StackPane>

                    <Label fx:id="testResultLabel" text="Čeká na test..." wrapText="true" textAlignment="CENTER"
                           alignment="CENTER" maxWidth="Infinity"/>
                </VBox>

                <VBox alignment="CENTER" spacing="5.0" maxWidth="Infinity">
                    <Label fx:id="statusLabel" styleClass="title-label" text="Neplatné" textFill="#ff6b6b"
                           alignment="CENTER" textAlignment="CENTER" maxWidth="Infinity"/>
                    <Label fx:id="infoLabel" styleClass="text-muted" wrapText="true" textAlignment="CENTER"
                           alignment="CENTER" maxWidth="Infinity"/>
                </VBox>

                <Pane VBox.vgrow="ALWAYS"/>

                <HBox alignment="CENTER" spacing="10" maxWidth="Infinity">
                    <Button fx:id="clearButton" mnemonicParsing="false" prefWidth="100.0" styleClass="btn-secondary"
                            text="Vymazat"/>
                    <Button fx:id="saveButton" mnemonicParsing="false" prefWidth="100.0" styleClass="btn-primary"
                            text="Uložit" disable="true"/>
                </HBox>
            </children>
        </VBox>
    </right>

</BorderPane>
