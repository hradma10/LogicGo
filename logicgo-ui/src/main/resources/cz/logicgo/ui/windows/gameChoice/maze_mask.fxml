<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:id="rootPane" prefHeight="650.0" prefWidth="900.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER" styleClass="header-pane" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" top="15.0"/>
            </padding>
            <Label text="" styleClass="title-label"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="gameContainer" styleClass="game-container-wrapper" BorderPane.alignment="CENTER">
            <Pane fx:id="canvasPane" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="500.0" prefWidth="500.0"
                  styleClass="canvas-pane">
                <Canvas fx:id="canvas" height="500.0" width="500.0"/>
            </Pane>
        </StackPane>
    </center>

    <right>
        <VBox alignment="TOP_CENTER" fillWidth="false" prefWidth="250.0" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <children>
                <Label text="Velikost masky:" styleClass="text-muted"/>

                <HBox spacing="10" alignment="CENTER">
                    <TextField fx:id="widthField" prefWidth="60.0" styleClass="input-field" promptText="Šířka"
                               alignment="CENTER"/>
                    <Label text="x" styleClass="text-muted"/>
                    <TextField fx:id="heightField" prefWidth="60.0" styleClass="input-field" promptText="Výška"
                               alignment="CENTER"/>
                </HBox>

                <Button fx:id="resizeButton" mnemonicParsing="false" prefWidth="150.0" styleClass="btn-secondary"
                        text="Změnit velikost"/>

                <Pane prefHeight="10.0"/>
                <VBox alignment="CENTER" spacing="5.0">
                    <Label fx:id="statusLabel" styleClass="title-label" text="Spojené" textFill="#4caf50"/>
                    <Label fx:id="infoLabel" styleClass="text-muted" text="Všechny buňky jsou dostupné." wrapText="true"
                           textAlignment="CENTER"/>
                </VBox>

                <Pane VBox.vgrow="ALWAYS"/>

                <VBox spacing="10">
                    <Button fx:id="saveButton" mnemonicParsing="false" prefWidth="150.0" styleClass="btn-primary"
                            text="Uložit masku"/>
                    <Button fx:id="clearButton" mnemonicParsing="false" prefWidth="150.0" styleClass="btn-secondary"
                            text="Vymazat"/>
                </VBox>
            </children>
        </VBox>
    </right>

</BorderPane>
