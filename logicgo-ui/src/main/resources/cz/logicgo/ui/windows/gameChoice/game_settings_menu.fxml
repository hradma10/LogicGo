<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox spacing="20" styleClass="root-pane"
      xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <children>
        <HBox spacing="20" VBox.vgrow="ALWAYS">
            <children>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            style="-fx-background-color: transparent; -fx-background: transparent;"
                            HBox.hgrow="ALWAYS">
                    <content>
                        <VBox spacing="10">
                            <children>
                                <GridPane fx:id="gridPane" hgap="10.0" vgap="10.0"/>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

                <VBox alignment="TOP_RIGHT" spacing="10">
                    <children>
                        <Pane fx:id="pane" maxHeight="450.0" maxWidth="450.0" minHeight="450.0" minWidth="450.0"
                              prefHeight="450.0" prefWidth="450.0" styleClass="canvas-pane">
                            <children>
                                <Canvas fx:id="canvas" height="450.0" width="450.0"/>
                            </children>
                        </Pane>

                        <Label fx:id="statusLabel" text="Připraveno" textFill="#666666" alignment="CENTER"
                               maxWidth="450.0">
                            <font>
                                <Font name="System Italic" size="13.0"/>
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <Region VBox.vgrow="NEVER"/>

        <HBox alignment="CENTER_RIGHT" spacing="10" VBox.vgrow="NEVER">
            <children>
                <Button fx:id="favoriteButton" mnemonicParsing="false" text="Oblíbené"/>
                <Button fx:id="okButton" defaultButton="true" text="OK"/>
                <Button fx:id="cancelButton" cancelButton="true" text="Cancel"/>
            </children>
        </HBox>
    </children>
</VBox>
