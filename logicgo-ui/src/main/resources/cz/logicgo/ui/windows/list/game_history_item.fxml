<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<HBox fx:id="list_item" alignment="CENTER_LEFT" spacing="15.0" styleClass="history-item-card" xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cz.logicgo.ui.controllers.listControllers.GameItemController">

    <ImageView fx:id="thumbnailView" fitHeight="80" fitWidth="80" preserveRatio="true"/>

    <VBox alignment="CENTER_LEFT" spacing="5" HBox.hgrow="ALWAYS">
        <Label fx:id="titleLabel" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #e0e0e0;"/>
        <Label fx:id="infoLabel" styleClass="text-muted"/>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="viewButton" styleClass="btn-secondary"/>
        <Button fx:id="deleteButton" styleClass="btn-delete"/>
    </HBox>
</HBox>
