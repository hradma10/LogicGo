<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<StackPane styleClass="root-pane" xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="cz.logicgo.ui.controllers.screenControllers.LoginController">
    <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
          prefWidth="380.0" spacing="15.0" styleClass="login-card">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
        </padding>

        <VBox alignment="CENTER" spacing="5.0">
            <VBox.margin>
                <Insets bottom="20.0"/>
            </VBox.margin>
            <Label fx:id="welcomeLabel" styleClass="app-brand">
                <font>
                    <Font name="System Bold" size="28.0"/>
                </font>
            </Label>
        </VBox>

        <VBox alignment="CENTER_LEFT" spacing="5.0">
            <Label fx:id="passwordLabel" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" styleClass="input-field"/>
        </VBox>

        <HBox alignment="CENTER" spacing="15.0">
            <VBox.margin>
                <Insets top="10.0"/>
            </VBox.margin>
            <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#goBack" styleClass="btn-secondary"
                    text="Zpět"/>
            <Button fx:id="loginButton" defaultButton="true" mnemonicParsing="false" onAction="#loginUser"
                    styleClass="btn-primary" text="Odemknout"/>
        </HBox>
    </VBox>
</StackPane>
