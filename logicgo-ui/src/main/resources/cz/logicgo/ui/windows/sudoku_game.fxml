<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="900.0" prefWidth="1600.0" styleClass="root-pane"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cz.logicgo.ui.controllers.gameControllers.gameControllers.SudokuGameController">

    <top>
        <ToolBar fx:id="topToolbar" styleClass="game-toolbar" BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <Pane fx:id="gamePane" styleClass="game-container-wrapper" BorderPane.alignment="CENTER"
              onKeyPressed="#onKeyPressed"
              onKeyReleased="#onKeyReleased"
              onMouseClicked="#onMouseClicked"
              onMouseReleased="#onMouseReleased"
              onMouseMoved="#onMouseMoved">
            <children>
                <Canvas fx:id="clueCanvas"/>
                <Canvas fx:id="secondaryCanvas"/>
                <Canvas fx:id="primaryCanvas"/>
            </children>
        </Pane>
    </center>

    <right>
        <VBox alignment="TOP_CENTER" fillWidth="false" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="465.0"
              prefWidth="234.0" spacing="50.0" BorderPane.alignment="CENTER_LEFT">
            <children>
                <Label fx:id="countdownTimer" styleClass="game-timer" text="00:00"/>
                <Button fx:id="buttonPause" onAction="#onPauseButtonPressed" styleClass="btn-primary"/>
            </children>
        </VBox>
    </right>
</BorderPane>
