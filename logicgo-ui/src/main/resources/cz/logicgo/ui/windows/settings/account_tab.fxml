<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cz.logicgo.ui.controllers.settingsControllers.AccountTabController">
    <content>
        <VBox alignment="TOP_CENTER" spacing="25.0">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
            </padding>

            <VBox alignment="CENTER" spacing="15.0">
                <children>
                    <Label fx:id="accountTitleLabel" text="Můj Účet">
                        <font>
                            <Font name="System Bold" size="24.0"/>
                        </font>
                    </Label>

                    <HBox alignment="CENTER" spacing="10.0">
                        <children>
                            <Label fx:id="loggedInAsLabel" text="Přihlášen jako:" textFill="#555555">
                                <font>
                                    <Font size="16.0"/>
                                </font>
                            </Label>
                            <Label fx:id="usernameLabel" text="[username]" textFill="#2a75d3">
                                <font>
                                    <Font name="System Bold" size="18.0"/>
                                </font>
                            </Label>
                        </children>
                    </HBox>

                    <FlowPane alignment="CENTER" hgap="15.0" prefWrapLength="450.0" vgap="10.0">
                        <children>
                            <Button fx:id="setDefaultButton" mnemonicParsing="false"
                                    onAction="#onSetDefaultAccountClicked" prefWidth="170.0"
                                    text="Nastavit jako výchozí"/>
                            <Button fx:id="changePasswordButton" mnemonicParsing="false"
                                    onAction="#onChangePasswordClicked" prefWidth="130.0" text="Změnit heslo"/>
                            <Button fx:id="deleteAccountButton" mnemonicParsing="false"
                                    onAction="#onDeleteAccountClicked" prefWidth="130.0"
                                    style="-fx-background-color: #d9534f; -fx-text-fill: white;" text="Smazat účet"/>
                        </children>
                        <VBox.margin>
                            <Insets top="10.0"/>
                        </VBox.margin>
                    </FlowPane>
                </children>
            </VBox>

            <Separator prefWidth="200.0"/>

            <VBox alignment="CENTER" spacing="20.0">
                <children>
                    <Label fx:id="statisticsTitleLabel" text="Moje Statistiky">
                        <font>
                            <Font name="System Bold" size="20.0"/>
                        </font>
                    </Label>

                    <GridPane hgap="30.0" maxWidth="400.0" vgap="15.0">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0"/>
                            <ColumnConstraints halignment="LEFT" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                        </rowConstraints>
                        <children>
                            <Label fx:id="totalGamesTextLabel" text="Celkem odehraných her:">
                                <font>
                                    <Font size="14.0"/>
                                </font>
                            </Label>
                            <Label fx:id="totalGamesLabel" text="0" GridPane.columnIndex="1">
                                <font>
                                    <Font name="System Bold" size="14.0"/>
                                </font>
                            </Label>

                            <Label fx:id="finishedGamesTextLabel" text="Dokončené hry:" GridPane.rowIndex="1">
                                <font>
                                    <Font size="14.0"/>
                                </font>
                            </Label>
                            <Label fx:id="finishedGamesLabel" text="0" textFill="#2da84a" GridPane.columnIndex="1"
                                   GridPane.rowIndex="1">
                                <font>
                                    <Font name="System Bold" size="14.0"/>
                                </font>
                            </Label>

                            <Label fx:id="inProgressGamesTextLabel" text="Rozehrané hry:" GridPane.rowIndex="2">
                                <font>
                                    <Font size="14.0"/>
                                </font>
                            </Label>
                            <Label fx:id="inProgressGamesLabel" text="0" textFill="#d3912a" GridPane.columnIndex="1"
                                   GridPane.rowIndex="2">
                                <font>
                                    <Font name="System Bold" size="14.0"/>
                                </font>
                            </Label>
                        </children>
                    </GridPane>
                </children>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
