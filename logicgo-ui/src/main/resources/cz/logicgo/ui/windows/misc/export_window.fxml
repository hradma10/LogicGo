<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="664.0" prefWidth="637.0" styleClass="root-pane"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cz.logicgo.ui.controllers.gameControllers.ExportWindowController">
    <bottom>
        <HBox alignment="CENTER_RIGHT" prefHeight="60.0" spacing="10.0" BorderPane.alignment="BOTTOM_CENTER">
            <children>
                <Button fx:id="buttonPrint" onAction="#printAction" styleClass="btn-secondary" text="Tisk"/>
                <Button fx:id="buttonExport" onAction="#exportAction" styleClass="btn-primary" text="Exportovat"/>
            </children>
            <padding>
                <Insets top="10.0" right="20.0" bottom="20.0"/>
            </padding>
        </HBox>
    </bottom>

    <right>
        <VBox fx:id="rightVbox" alignment="CENTER_LEFT" fillWidth="false" prefWidth="400.0"
              BorderPane.alignment="CENTER">
            <children>
                <CheckBox fx:id="generateHelpCheckBox" styleClass="export-help-checkbox" text="Generovat pravidla"/>
            </children>
            <padding>
                <Insets top="20.0" right="20.0" left="10.0"/>
            </padding>
        </VBox>
    </right>

    <center>
        <StackPane BorderPane.alignment="CENTER">
            <children>
                <Pane fx:id="pane" maxHeight="600.0" maxWidth="600.0" minHeight="600.0" minWidth="600.0"
                      prefHeight="600.0" prefWidth="600.0" styleClass="canvas-pane">
                    <children>
                        <Canvas fx:id="clueCanvas" height="600.0" layoutY="1.0" width="600.0"/>
                        <Canvas fx:id="canvas" height="600.0" layoutY="1.0" width="600.0"/>
                    </children>
                </Pane>
            </children>
            <padding>
                <Insets top="20.0" left="20.0" right="20.0"/>
            </padding>
        </StackPane>
    </center>
</BorderPane>
