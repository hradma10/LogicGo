<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<GridPane fx:id="gridPane" hgap="20" minHeight="500.0" minWidth="800.0" styleClass="root-pane" vgap="20" xmlns="http://javafx.com/javafx/23.0.1"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="cz.logicgo.ui.controllers.screenControllers.WelcomeScreenController">

    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" percentWidth="65.0" minWidth="450"/>
        <ColumnConstraints hgrow="ALWAYS" percentWidth="35.0" minWidth="280"/>
    </columnConstraints>

    <rowConstraints>
        <RowConstraints maxHeight="20.0" minHeight="20.0" prefHeight="20.0" vgrow="ALWAYS"/>
        <RowConstraints maxHeight="95.0" minHeight="10.0" prefHeight="95.0" vgrow="ALWAYS"/>
        <RowConstraints maxHeight="195.0" minHeight="135.0" prefHeight="171.0" vgrow="ALWAYS"/>
        <RowConstraints maxHeight="406.0" minHeight="375.0" prefHeight="375.0" vgrow="ALWAYS"/>
        <RowConstraints vgrow="ALWAYS"/>
    </rowConstraints>

    <children>
        <Label fx:id="appTitle" styleClass="app-title" text="LogicGo" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <padding>
                <Insets left="40.0"/>
            </padding>
        </Label>

        <Button fx:id="switchProfileButton" onMouseClicked="#logoutUser" styleClass="btn-secondary" text="Změnit profil"
                GridPane.columnIndex="1" GridPane.rowIndex="1"
                GridPane.halignment="RIGHT" GridPane.valignment="TOP">
            <GridPane.margin>
                <Insets right="20.0" top="10.0"/>
            </GridPane.margin>
        </Button>

        <Label fx:id="welcomeLabel" styleClass="greeting-label" text="Vítejte zpět!" wrapText="true"
               style="-fx-font-size: 18px;" GridPane.columnIndex="0" GridPane.rowIndex="2" alignment="TOP_LEFT">
            <GridPane.margin>
                <Insets left="40.0" top="10.0" right="10.0"/>
            </GridPane.margin>
        </Label>

        <TilePane alignment="CENTER_LEFT" hgap="20.0" prefHeight="300.0" tileAlignment="TOP_LEFT" vgap="20.0"
                  GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.rowSpan="2">
            <children>
                <VBox fx:id="gameButton" alignment="CENTER" onMouseClicked="#openMenu" prefHeight="140.0"
                      prefWidth="160.0" spacing="10" styleClass="dashboard-button">
                    <StackPane fx:id="playIconPane" prefHeight="60.0" prefWidth="60.0"/>
                    <Label fx:id="playBoxLabel" text="Hrát"/>
                </VBox>
                <VBox fx:id="historyButton" alignment="CENTER" onMouseClicked="#openHistoryList" prefHeight="140.0"
                      prefWidth="160.0" spacing="10" styleClass="dashboard-button">
                    <StackPane fx:id="historyIconPane" prefHeight="60.0" prefWidth="60.0"/>
                    <Label fx:id="historyBoxLabel" text="Historie"/>
                </VBox>
                <VBox fx:id="settingsButton" onMouseClicked="#openSettingsButton" alignment="CENTER" prefHeight="140.0"
                      prefWidth="160.0" spacing="10" styleClass="dashboard-button">
                    <StackPane fx:id="settingsIconPane" prefHeight="60.0" prefWidth="60.0"/>
                    <Label fx:id="settingsBoxLabel" text="Nastavení"/>
                </VBox>
                <VBox fx:id="exportButton" alignment="CENTER" onMouseClicked="#openExportButton" prefHeight="140.0"
                      prefWidth="160.0" spacing="10" styleClass="dashboard-button">
                    <StackPane fx:id="exportIconPane" prefHeight="60.0" prefWidth="60.0"/>
                    <Label fx:id="exportBoxLabel" text="Export"/>
                </VBox>
            </children>
            <padding>
                <Insets left="40.0"/>
            </padding>
        </TilePane>

        <VBox fx:id="lastPlayedBox" onMouseClicked="#resumeLastGame" prefHeight="200.0" prefWidth="100.0" spacing="5"
              styleClass="dashboard-widget" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <children>
                <Label fx:id="lastPlayedGameTitle" styleClass="widget-title" text="" wrapText="true"
                       style="-fx-font-size: 16px;"/>
                <Label fx:id="lastPlayedGameTime" styleClass="text-muted" text="" wrapText="true"/>
                <Pane VBox.vgrow="ALWAYS"/>
                <Button fx:id="resumeLastGameButton" onMouseClicked="#resumeLastGame" styleClass="btn-secondary" text=""
                        maxWidth="Infinity"/>
            </children>
            <GridPane.margin>
                <Insets right="20.0" bottom="10.0" top="10.0"/>
            </GridPane.margin>
        </VBox>

        <VBox fx:id="dailyGameBox" onMouseClicked="#playDailyGameWrapper" alignment="TOP_CENTER" spacing="10.0"
              styleClass="dashboard-widget" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <Label fx:id="dailyGameTitle" styleClass="widget-title" text="" wrapText="true"
                   style="-fx-font-size: 16px; -fx-text-alignment: center;"/>
            <StackPane fx:id="dailyGamePane" styleClass="canvas-pane" prefHeight="200.0" prefWidth="200.0">
                <children>
                    <Canvas fx:id="dailyGameCanvas" height="200.0" width="200.0"/>
                </children>
            </StackPane>
            <Button fx:id="dailyGameButton" onMouseClicked="#playDailyGameWrapper" styleClass="btn-primary" text=""
                    maxWidth="Infinity"/>
            <GridPane.margin>
                <Insets right="20.0" bottom="20.0"/>
            </GridPane.margin>
        </VBox>
    </children>
</GridPane>
